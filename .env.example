# Neumann 환경 설정 견본
#
# 쓰는 법: 이 파일을 .env로 복사하고 값을 채운다.  cp .env.example .env
# - .env는 .gitignore로 막혀 있다. 공개 저장소이니 절대 커밋하지 않는다.
# - 이 견본의 비밀값 칸(KEY·SECRET·TOKEN·SALT)은 항상 비워 둔다. verify가 검사한다.
# - 키를 코드·로그·보고서·커밋 메시지에 쓰지 않는다. 코드는 환경변수로만 읽는다.

# ── 비밀값 ─────────────────────────────────────────────
# OPENAI_API_KEY는 환경변수가 .env보다 우선한다. 설정 로더도 이 순서를 지킨다(환경변수 > .env).
# 이 노트북은 Windows 사용자 환경변수에 키가 있으니 .env에는 이 줄을 두지 않는다(빈 값이 키를 가리지 않게).
# 환경변수가 없는 곳에서만 .env에 채운다.
# OPENAI_API_KEY=
# 익명화 해시 솔트. 비어 있으면 익명화를 거부한다.
NEUMANN_PSEUDONYM_SALT=

# ── 제품 LLM ───────────────────────────────────────────
# provider: openai | mock   (로컬 LLM 없음, 계획서 §1.2)
NEUMANN_LLM_PROVIDER=openai
NEUMANN_LLM_MODEL=gpt-6-astra
# 호출 단계별 시간 상한(초). 넘으면 그 단계만 비상 규칙 경로로 강등하고 status에 표기한다.
NEUMANN_LLM_TIMEOUT_S=60

# ── 임베딩·데이터 경로 (저장소 밖 공개자료) ─────────────
# 로컬 폴더 경로. 인터넷 없이 불러온다.
NEUMANN_EMBED_MODEL=
NEUMANN_RAW_DIR=
NEUMANN_DATA_DIR=./data
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── 서버 ───────────────────────────────────────────────
NEUMANN_API_HOST=127.0.0.1
NEUMANN_API_PORT=8000

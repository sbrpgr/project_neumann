{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "neumann/api/templates/catalog.schema.json",
  "title": "AI for Science 템플릿 카탈로그",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "required_sections", "templates", "examples"],
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
    "label": {"type": "string", "minLength": 1, "maxLength": 80}
  },
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "domains"],
      "properties": {
        "label": {"$ref": "#/definitions/label"},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/label"}}
      }
    },
    "required_sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/label"}},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domain", "summary", "file"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"$ref": "#/definitions/label"},
          "domain": {"$ref": "#/definitions/label"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 120},
          "file": {"type": "string", "pattern": "^[a-z0-9_]+[.]md$"}
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domain", "template_id", "path"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"$ref": "#/definitions/label"},
          "domain": {"$ref": "#/definitions/label"},
          "template_id": {"$ref": "#/definitions/id"},
          "path": {"type": "string", "pattern": "^(src/neumann/api/templates/examples|tests/fixtures/plans)/[A-Za-z0-9_-]+[.]md$"}
        }
      }
    }
  }
}
